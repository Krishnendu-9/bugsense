# Backend API base URL: absolute, or relative (/api) when served behind a proxy.
VITE_API_URL=http://localhost:5000/api

# Same value as the server's TELEMETRY_INGEST_KEY, if one is set.
VITE_TELEMETRY_INGEST_KEY=

# Report the dashboard's own crashes to BugSense (default: on in production builds).
VITE_SELF_REPORT=

# "true" lists the seeded demo accounts on the sign-in page. Leave unset for
# any real deployment.
VITE_DEMO_MODE=
