# development locally; production on any deployed host. Left unset, the server
# warns and runs with development defaults (built-in JWT secret, open sign-up).
NODE_ENV=development
PORT=5000
MONGO_URI=
# Required in production (32+ random characters): openssl rand -hex 32
JWT_SECRET=
ANTHROPIC_API_KEY=
# Dashboard origin(s), comma-separated. The first is used in alert/issue links.
CLIENT_URL=http://localhost:5173

# Proxy hops in front of the API: 0 if clients reach Node directly, 1 for one
# proxy that is the only way in. Wrong values let clients spoof their IP past
# the rate limits. Verify before deploying: docs/CONFIGURATION.md, section 4.
TRUST_PROXY=1

# May visitors sign up as developers? Unset: yes in development, no in production.
ALLOW_DEVELOPER_SIGNUP=

# Optional: SDK ingest key (the SDK's data-key attribute). Visible in page HTML.
TELEMETRY_INGEST_KEY=
# Optional: comma-separated origins allowed to post telemetry (default: any).
TELEMETRY_ALLOWED_ORIGINS=
# Max background AI analyses the public telemetry endpoint may start per hour.
TELEMETRY_AI_HOURLY_BUDGET=20
# Max background AI analyses of new manual reports per hour.
REPORT_AI_HOURLY_BUDGET=100

# Days the audit trail keeps an entry before MongoDB deletes it (0 = forever).
AUDIT_RETENTION_DAYS=365

# Optional: store uploads in Cloudinary instead of local disk (needed on hosts
# that wipe the disk on deploy). Format: cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=bugsense

# Optional integrations
GITHUB_TOKEN=
# Repositories (owner/repo, comma-separated) the server's GITHUB_TOKEN may use.
GITHUB_ALLOWED_REPOS=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
