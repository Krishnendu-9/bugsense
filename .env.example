# Root-level overrides consumed by docker-compose.yml.
# Copy to .env and fill in before running `docker compose up`.

# Generate with: openssl rand -hex 32
# Left empty, compose falls back to a public demo secret and the server starts
# only because ALLOW_INSECURE_JWT_SECRET defaults to true (with a warning).
# For a real deployment set JWT_SECRET and uncomment the next line, so the
# server refuses to start if the secret is ever missing or weak.
JWT_SECRET=
# ALLOW_INSECURE_JWT_SECRET=false
ANTHROPIC_API_KEY=
# Where the Docker client is served (compose publishes it on 8080).
CLIENT_URL=http://localhost:8080

# The local demo lets visitors sign up as developers; set false to require an
# admin to promote people from the Team page.
ALLOW_DEVELOPER_SIGNUP=true

# Demo stack: the seed may create the demo accounts (published password) and
# the sign-in page lists them. Set both to false for anything that is not a demo.
ALLOW_DEMO_SEED=true
DEMO_MODE=true

# Optional: SDK ingest key (data-key attribute). Also baked into the client
# image so the SDK Playground keeps working.
TELEMETRY_INGEST_KEY=
# Optional: comma-separated origins allowed to post telemetry (default: any).
TELEMETRY_ALLOWED_ORIGINS=
# Max background AI analyses per hour: public telemetry / new manual reports.
TELEMETRY_AI_HOURLY_BUDGET=20
REPORT_AI_HOURLY_BUDGET=100

# Optional: store uploads in Cloudinary: cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=

# Optional integrations
GITHUB_TOKEN=
# owner/repo list (comma-separated) the server's GITHUB_TOKEN may file issues in
GITHUB_ALLOWED_REPOS=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
